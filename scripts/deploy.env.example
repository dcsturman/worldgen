# Copy to `scripts/deploy.env` (gitignored) and fill in. `scripts/push_image.sh`
# sources this; any value can also be overridden by exporting it in the
# environment for a one-off deploy.

# GCP project hosting the Cloud Run service and the GCR image.
GCP_PROJECT="${GCP_PROJECT:-your-gcp-project-id}"

# Bucket for the /api/world planet-render cache. "debug" or unset disables
# caching, and every request then regenerates from scratch (~10 s for a cold
# globe), so set a real bucket for anything user-facing.
GCS_BUCKET="${GCS_BUCKET:-worldgen-cache}"

# Upstream TravellerMap host for sector lookups, search and tile rendering.
#
# Baked into BOTH the WASM bundle and the native server binary at compile
# time (option_env! in src/util.rs) — there is no runtime override, and an
# image built against the wrong host looks completely healthy while talking
# to the wrong server. Set it here so a deploy can't silently fall back to
# the public service.
#
# Leave as the public service unless you run your own instance.
TRAVELLERMAP_URL="${TRAVELLERMAP_URL:-https://travellermap.com}"
